<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   追风者 —— Web 应用部署描述符
  ============================================================================
   本文件当前只声明与「前端界面」有关的部分：
     · 欢迎页（index.html）
     · 请求/响应字符编码（Servlet 4.0 声明式，无需手写 Filter 类）
     · 会话超时
   后端 Servlet / Filter 的注册一律使用注解（@WebServlet / @WebFilter），
   好处：新增接口不必再改 web.xml，类与 URL 的对应关系就近可读。
   下方「接口注册对照表」列出预期要写的 Servlet 与其 URL，供后续开发对照。
  ============================================================================
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>追风者 · 台风实况监测与灾害辅助分析 Web 平台</display-name>

  <!-- ==================== 字符编码 ====================
       Servlet 4.0 声明式配置，等价于手写 CharacterEncodingFilter，
       但不需要额外的 Java 类。前后端 JSON 交互统一 UTF-8。 -->
  <request-character-encoding>UTF-8</request-character-encoding>
  <response-character-encoding>UTF-8</response-character-encoding>

  <!-- ==================== 欢迎页 ====================
       访问 http://localhost:8080/typhoon_platform/ 时自动打开监测总览 -->
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <!-- ==================== 会话 ====================
       30 分钟无操作自动失效。登录态由后续的 LoginServlet 写入 Session。 -->
  <session-config>
    <session-timeout>30</session-timeout>
    <!-- 防会话固定攻击：未登录时不给客户端发 JSESSIONID -->
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>

  <!--
  ============================================================================
   接口注册对照表（后端已实现 · 类文件内用 @WebServlet 声明，此处仅作索引）
  ============================================================================
   前端按下列契约调用（见 src/main/webapp/js/api.js 与 docs/api.md），
   后端已让 URL 与响应结构完全对上。

   类名（com.zfz.typhoon.servlet 包）      @WebServlet 映射
   ===========================================================================
   AuthServlet                /api/auth/*
   TyphoonServlet             /api/typhoons/*      （列表 / 详情 / tracks /
                                                     wind-circles /
                                                     forecast-paths /
                                                     disagreement / replay /
                                                     disaster / meta）
   AiPredictionServlet        /api/ai/predictions
   RiskAssessmentServlet      /api/risk/assessments
   SimilarCaseServlet         /api/similar-cases
   SandboxServlet             /api/sandbox/scenarios/*
   SurveyServlet              /api/surveys/*
   ExportServlet              /api/export/*
   MetaServlet                /api/cities、/api/agencies
   NotificationServlet        /api/notifications/*
   FavoriteServlet            /api/favorites/*
   SubscriptionServlet        /api/subscriptions/*
   ComparisonServlet          /api/comparisons/*
   FeedbackServlet            /api/feedback
   AdminServlet               /api/admin/*
   HealthServlet              /api/health

   过滤器：
   CorsFilter                 /api/*               跨域（开发阶段静态服务）
   AuthFilter                 /api/*               鉴权（/api/admin/** 需管理员）

   说明一：Servlet 3.0+ 不支持 {id} 这种路径变量写法，因此统一用
          @WebServlet("/资源/*") 并在 doGet 里解析 pathInfo
          （api.md 第 5 节给出了解析范式，实现见 BaseServlet#pathSegments）。
          路由按「资源族」而不是「单个 URL」划分：
          /api/typhoons/{id}/tracks 与 /wind-circles 等共享同一段解析逻辑，
          拆成 6 个类会把同一段代码抄 6 遍，且通配符映射会互相抢占。

   说明二：所有接口在业务失败时 HTTP 状态码仍为 200，
          真正的成败由响应体里的 code 表达。原因是前端 api.js 在
          jQuery 的 done 回调里判断 res.code，若返回 HTTP 4xx/5xx，
          请求会落到 fail 回调，服务层精心写的提示文案
          （如「该台风暂无轨迹数据」）会全部丢失。
          实现见 BaseServlet#service。
  ============================================================================
  -->

</web-app>
